{
  "name": "launchly-load-tests",
  "version": "1.0.0",
  "description": "High-Load and Performance Testing Suite for Launchly SaaS using Grafana k6 and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack",
    "test:auth": "webpack && k6 run --out web-dashboard=export=reports/01-auth-report.html dist/01-auth-burst.bundle.js",
    "test:telegram": "webpack && k6 run --out web-dashboard=export=reports/02-telegram-report.html dist/02-telegram-surge.bundle.js",
    "test:crm": "webpack && k6 run --out web-dashboard=export=reports/03-crm-report.html dist/03-crm-leads.bundle.js",
    "test:billing": "webpack && k6 run --out web-dashboard=export=reports/04-billing-report.html dist/04-plan-limits.bundle.js",
    "test:100nodes": "webpack && k6 run --out web-dashboard=export=reports/05-100nodes-report.html dist/05-massive-100node.bundle.js",
    "test:broadcasts": "webpack && k6 run --out web-dashboard=export=reports/06-broadcasts-report.html dist/06-broadcasts.bundle.js",
    "test:analytics": "webpack && k6 run --out web-dashboard=export=reports/07-analytics-report.html dist/07-analytics.bundle.js",
    "test:ai": "webpack && k6 run --out web-dashboard=export=reports/08-ai-report.html dist/08-ai-generation.bundle.js",
    "test:support": "webpack && k6 run --out web-dashboard=export=reports/09-support-report.html dist/09-support-chat.bundle.js",
    "test:integrations": "webpack && k6 run --out web-dashboard=export=reports/10-integrations-report.html dist/10-integrations.bundle.js",
    "test:ratelimit": "webpack && k6 run --out web-dashboard=export=reports/11-ratelimit-report.html dist/11-rate-limiting.bundle.js",
    "test:idempotency": "webpack && k6 run --out web-dashboard=export=reports/12-idempotency-report.html dist/12-idempotency.bundle.js",
    "test:security": "webpack && k6 run --out web-dashboard=export=reports/13-security-report.html dist/13-security-headers.bundle.js",
    "test:outbox": "webpack && k6 run --out web-dashboard=export=reports/14-outbox-report.html dist/14-transactional-outbox.bundle.js",
    "test:batching": "webpack && k6 run --out web-dashboard=export=reports/15-batching-report.html dist/15-jdbc-batching.bundle.js",
    "test:tierlimits": "webpack && k6 run --out web-dashboard=export=reports/16-tierlimits-report.html dist/16-tier-rate-limits.bundle.js",
    "test:entitygraph": "webpack && k6 run --out web-dashboard=export=reports/17-entitygraph-report.html dist/17-deep-entity-graph.bundle.js",
    "test:all": "webpack && k6 run --out web-dashboard=export=reports/all-scenarios-report.html dist/all-scenarios.bundle.js"
  },
  "keywords": ["k6", "load-testing", "performance", "typescript", "launchly"],
  "author": "Launchly Team",
  "license": "MIT",
  "devDependencies": {
    "@types/k6": "^0.54.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "glob": "^11.0.1"
  }
}
