{
  "threshold": 6,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.lighthouseci/**",
    "**/test-results/**",
    "**/db/changelog/**",
    "**/*.json",
    "**/*.svg",
    "**/*.properties",
    "**/*.sql",
    "**/*.md",
    "**/*.txt"
  ],
  "format": [
    "java",
    "typescript",
    "javascript"
  ],
  "path": [
    "backend/src/main/java",
    "frontend/src"
  ]
}
